<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ImportGroup Label="PropertySheets">
  </ImportGroup>
  <PropertyGroup Label="UserMacros" />
  <PropertyGroup>
    <_ProjectFileVersion>11.0.50727.1</_ProjectFileVersion>
    <PlayasaCargoExe Condition="'$(PlayasaCargoExe)'=='' And Exists('$(USERPROFILE)\.cargo\bin\cargo.exe')">$(USERPROFILE)\.cargo\bin\cargo.exe</PlayasaCargoExe>
    <PlayasaCargoExe Condition="'$(PlayasaCargoExe)'==''">cargo</PlayasaCargoExe>
    <PlayasaRustSphashTarget Condition="'$(Platform)'=='Win32'">i686-pc-windows-msvc</PlayasaRustSphashTarget>
    <PlayasaRustSphashProfile Condition="'$(Configuration)'=='Debug' Or '$(Configuration)'=='Debug Unicode'">debug</PlayasaRustSphashProfile>
    <PlayasaRustSphashProfile Condition="'$(PlayasaRustSphashProfile)'==''">release</PlayasaRustSphashProfile>
    <PlayasaRustSphashCargoArgs Condition="'$(PlayasaRustSphashProfile)'=='release'">--release</PlayasaRustSphashCargoArgs>
    <PlayasaRustSphashCargoTargetDir>$(SolutionDir)..\out\obj\rust</PlayasaRustSphashCargoTargetDir>
    <PlayasaRustSphashOutputDir>$(PlayasaRustSphashCargoTargetDir)\$(PlayasaRustSphashTarget)\$(PlayasaRustSphashProfile)\</PlayasaRustSphashOutputDir>
    <PlayasaRustSphashDll>$(PlayasaRustSphashOutputDir)playasa_sphash.dll</PlayasaRustSphashDll>
    <PlayasaRustSphashImportLib>$(PlayasaRustSphashOutputDir)playasa_sphash.dll.lib</PlayasaRustSphashImportLib>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(SolutionDir)Thirdparty\pkg;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalDependencies>playasa_sphash.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <AdditionalLibraryDirectories>$(SolutionDir)..\out\lib\$(Platform)\$(Configuration)\;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Link>
  </ItemDefinitionGroup>
  <Target Name="BuildPlayasaRustSphash" BeforeTargets="Link" Condition="'$(PlayasaRustSphashTarget)'!=''">
    <Message Importance="High" Text="Building Rust sphash DLL for $(Platform)|$(Configuration)..." />
    <MakeDir Directories="$(SolutionDir)..\out\bin\$(Platform)\$(Configuration)\;$(SolutionDir)..\out\lib\$(Platform)\$(Configuration)\;$(PlayasaRustSphashCargoTargetDir)" />
    <Exec Command="set &quot;CARGO_TARGET_DIR=$(PlayasaRustSphashCargoTargetDir)&quot; &amp;&amp; &quot;$(PlayasaCargoExe)&quot; build --manifest-path &quot;$(SolutionDir)..\Cargo.toml&quot; -p playasa-sphash --target $(PlayasaRustSphashTarget) $(PlayasaRustSphashCargoArgs)" />
    <Copy SourceFiles="$(PlayasaRustSphashDll)" DestinationFolder="$(SolutionDir)..\out\bin\$(Platform)\$(Configuration)\" />
    <Copy SourceFiles="$(PlayasaRustSphashImportLib)" DestinationFiles="$(SolutionDir)..\out\lib\$(Platform)\$(Configuration)\playasa_sphash.lib" />
  </Target>
  <ItemGroup />
</Project>