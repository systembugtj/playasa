<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ImportGroup Label="PropertySheets">
  </ImportGroup>
  <PropertyGroup Label="UserMacros" />
  <PropertyGroup>
    <_ProjectFileVersion>11.0.50727.1</_ProjectFileVersion>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(SolutionDir)Thirdparty\librhash\librhash;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalDependencies>librhash.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <!-- librhash 工程在「Release Unicode」解配置下映射为 Release|Win32，产物在 out\bin\$(Platform)\Release\ -->
      <AdditionalLibraryDirectories>%(AdditionalLibraryDirectories);$(SolutionDir)..\out\bin\$(Platform)\Release\</AdditionalLibraryDirectories>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup />
</Project>